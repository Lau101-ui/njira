# Copy to .env.local for local development. Never commit real values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/njira?sslmode=require"

# Managed auth provider identifiers/secrets are server-side only.
AUTH_SECRET=""
AUTH_ISSUER=""
AUTH_AUDIENCE=""

# PayChangu — server-side secrets only; use test credentials first.
PAYCHANGU_SECRET_KEY=""
PAYCHANGU_WEBHOOK_SECRET=""
PAYCHANGU_API_BASE_URL="https://api.paychangu.com"

# Public application origin used for callback/return URLs.
APP_BASE_URL="http://localhost:3000"
