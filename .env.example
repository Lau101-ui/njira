# Copy to .env.local. Never commit real values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-bytes"

# Transactional authentication email (Resend)
RESEND_API_KEY="re_replace_with_a_sending_only_api_key"
AUTH_EMAIL_FROM="NJIRA <accounts@your-verified-domain.com>"
