generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum LegalDocumentType {
  TERMS_OF_SERVICE
  PRIVACY_NOTICE
  COOKIE_NOTICE
  CREATOR_AGREEMENT
  CLIENT_AGREEMENT
  SUPPLIER_AGREEMENT
  DIGITAL_CONTENT_CONSENT
}

enum LegalDocumentStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum ConsentPurpose {
  MARKETING_EMAIL
  MARKETING_SMS
  ANALYTICS
  PERSONALIZATION
  NON_ESSENTIAL_COOKIES
}

enum ConsentAction {
  GRANTED
  WITHDRAWN
}

enum DataSubjectRequestType {
  ACCESS
  RECTIFICATION
  ERASURE
  PORTABILITY
  RESTRICTION
  OBJECTION
  WITHDRAW_CONSENT
  COMPLAINT
}

enum DataSubjectRequestStatus {
  RECEIVED
  IDENTITY_CHECK
  IN_PROGRESS
  ON_HOLD_LEGAL_RETENTION
  COMPLETED
  REJECTED_WITH_REASON
}

enum ComplianceIncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ComplianceIncidentStatus {
  OPEN
  INVESTIGATING
  CONTAINED
  REPORTED
  CLOSED
}

enum JurisdictionApprovalStatus {
  PENDING
  APPROVED
  BLOCKED
}

enum ListingType {
  SERVICE
  DIGITAL_PRODUCT
  PHYSICAL_PRODUCT
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentProvider {
  PAYCHANGU
}

enum PaymentPurpose {
  ORDER_CHECKOUT
  PROPOSAL_APPLICATION_FEE
  DIGITAL_TOOL_PURCHASE
}

enum SupplierStatus {
  PENDING_REVIEW
  ACTIVE
  PAUSED
  SUSPENDED
}

enum DigitalToolStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ToolBillingInterval {
  ONE_TIME
  MONTHLY
  ANNUAL
  USAGE_BASED
}

enum DigitalServiceOrderStatus {
  PENDING_PAYMENT
  PAID
  FULFILLMENT_PENDING
  FULFILLING
  FULFILLED
  FAILED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  DISPUTED
}

enum FulfillmentStatus {
  QUEUED
  IN_PROGRESS
  DELIVERED
  FAILED
  REVOKED
}

enum FulfillmentMethod {
  AUTHORIZED_RESELLER
  REDEMPTION_CODE
  DIRECT_VENDOR_CHECKOUT_ASSIST
  MANUAL_APPROVED
}

enum BriefStatus {
  OPEN
  REVIEWING
  AWARDED
  CANCELLED
  CLOSED
}

enum ProposalStatus {
  SUBMITTED
  SHORTLISTED
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum MilestoneStatus {
  PENDING
  FUNDED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  RELEASED
  DISPUTED
}

enum MessageType {
  TEXT
  SYSTEM
  FILE
}

enum PayoutStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  REVERSED
}

enum LedgerEntryType {
  BUYER_PAYMENT
  PROVIDER_FEE
  PLATFORM_COMMISSION
  CREATOR_PAYABLE
  REFUND
  PAYOUT
  PLATFORM_APPLICATION_FEE
  ADJUSTMENT
  DIGITAL_TOOL_SALE
  SUPPLIER_COST
}

model User {
  id                String       @id @default(cuid())
  authProvider      String
  authSubject       String
  email             String       @unique
  status            UserStatus   @default(ACTIVE)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  clientProfile     ClientProfile?
  creatorProfile    CreatorProfile?
  listings          Listing[]    @relation("ListingOwner")
  buyerOrders       Order[]      @relation("OrderBuyer")
  briefs            Brief[]      @relation("BriefClient")
  proposals         Proposal[]   @relation("ProposalCreator")
  sentMessages      Message[]    @relation("MessageSender")
  reviewsWritten    Review[]     @relation("ReviewAuthor")
  reviewsReceived   Review[]     @relation("ReviewTarget")
  conversationMemberships ConversationParticipant[]
  digitalServiceOrders DigitalServiceOrder[]
  legalAcceptances   LegalAcceptance[]
  privacyRequests    DataSubjectRequest[] @relation("PrivacyRequestSubject")
  consentEvents      ConsentEvent[]

  @@unique([authProvider, authSubject])
  @@index([status, createdAt])
}

model ClientProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  company     String?
  bio         String?  @db.Text
  countryCode String   @default("MW")
  city        String?
  website     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreatorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  handle          String   @unique
  displayName     String
  headline        String?
  bio             String?  @db.Text
  countryCode     String   @default("MW")
  city            String?
  website          String?
  isVerified      Boolean  @default(false)
  acceptingWork   Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings        Listing[]
  proposals       Proposal[]
  receivedOrders  Order[]  @relation("OrderCreator")
  reviews         Review[] @relation("CreatorReviews")
  connectAccount  CreatorPaymentAccount?
  payouts         Payout[]
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  parentId  String?
  parent    Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  listings  Listing[]
  createdAt DateTime  @default(now())
}

model Listing {
  id              String        @id @default(cuid())
  creatorId       String
  ownerUserId     String
  categoryId      String?
  type            ListingType
  status          ListingStatus @default(DRAFT)
  title           String
  slug            String        @unique
  summary         String
  description     String        @db.Text
  currency        String        @default("MWK")
  price           Decimal       @db.Decimal(14, 2)
  compareAtPrice  Decimal?      @db.Decimal(14, 2)
  deliveryDays    Int?
  stockQuantity   Int?
  isDigital       Boolean       @default(false)
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  creator         CreatorProfile @relation(fields: [creatorId], references: [id])
  owner           User          @relation("ListingOwner", fields: [ownerUserId], references: [id])
  category        Category?     @relation(fields: [categoryId], references: [id])
  orderItems      OrderItem[]

  @@index([status, type, categoryId])
  @@index([creatorId, status])
}

model Brief {
  id           String      @id @default(cuid())
  clientId     String
  title        String
  description  String      @db.Text
  categoryId   String?
  budgetMin    Decimal?    @db.Decimal(14, 2)
  budgetMax    Decimal?    @db.Decimal(14, 2)
  currency     String      @default("MWK")
  deadline     DateTime?
  status       BriefStatus @default(OPEN)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  client       User        @relation("BriefClient", fields: [clientId], references: [id])
  proposals    Proposal[]

  @@index([status, createdAt])
  @@index([clientId, status])
}

model Proposal {
  id             String         @id @default(cuid())
  briefId        String
  creatorId      String
  creatorUserId  String
  coverMessage   String         @db.Text
  amount         Decimal        @db.Decimal(14, 2)
  currency       String         @default("MWK")
  estimatedDays  Int?
  status         ProposalStatus @default(SUBMITTED)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  brief          Brief          @relation(fields: [briefId], references: [id], onDelete: Cascade)
  creator        CreatorProfile @relation(fields: [creatorId], references: [id])
  creatorUser    User           @relation("ProposalCreator", fields: [creatorUserId], references: [id])
  milestones     Milestone[]
  applicationFeeAmount   Decimal?  @db.Decimal(14, 2)
  applicationFeeCurrency String?
  applicationFeeRequired Boolean   @default(false)
  payments       Payment[]
  ledgerEntries  LedgerEntry[]

  @@unique([briefId, creatorId])
  @@index([creatorId, status])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  buyerId         String
  creatorId       String
  status          OrderStatus @default(PENDING_PAYMENT)
  currency        String
  subtotal        Decimal     @db.Decimal(14, 2)
  /// Immutable fee amount charged for this order, calculated at order creation.
  platformFee     Decimal     @default(0) @db.Decimal(14, 2)
  /// Immutable commission rate snapshot as a fraction (for example, 0.08 = 8%).
  /// Application code must set this explicitly for new paid orders; zero remains safe for legacy/free orders.
  platformFeeRate Decimal     @default(0) @db.Decimal(7, 6)
  /// Actual provider fee once confirmed from provider settlement/reconciliation.
  providerFee     Decimal?    @db.Decimal(14, 2)
  /// Immutable legal disclosure snapshots for the transaction.
  sellerOfRecordName String?
  sellerOfRecordCountryCode String?
  sellerRole      String?
  termsVersion    String?
  privacyNoticeVersion String?
  total           Decimal     @db.Decimal(14, 2)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  paidAt          DateTime?
  buyer           User        @relation("OrderBuyer", fields: [buyerId], references: [id])
  creator         CreatorProfile @relation("OrderCreator", fields: [creatorId], references: [id])
  items           OrderItem[]
  payments        Payment[]
  milestones      Milestone[]
  ledgerEntries   LedgerEntry[]

  @@index([buyerId, createdAt])
  @@index([creatorId, status])
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  listingId         String?
  listingTitle      String
  listingType       ListingType
  description       String?
  quantity          Int      @default(1)
  unitPrice         Decimal  @db.Decimal(14, 2)
  lineTotal         Decimal  @db.Decimal(14, 2)
  creatorName       String
  metadataSnapshot  Json?
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing           Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
}

model Milestone {
  id          String          @id @default(cuid())
  orderId     String?
  proposalId  String?
  title       String
  description String?         @db.Text
  amount      Decimal         @db.Decimal(14, 2)
  currency    String
  dueAt       DateTime?
  status      MilestoneStatus @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  order       Order?          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  proposal    Proposal?       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String?
  proposalId        String?
  digitalServiceOrderId String?
  purpose           PaymentPurpose @default(ORDER_CHECKOUT)
  provider          PaymentProvider @default(PAYCHANGU)
  status            PaymentStatus   @default(PENDING)
  txRef             String          @unique
  providerReference String?
  checkoutUrl       String?
  amount            Decimal         @db.Decimal(14, 2)
  currency          String
  providerStatus    String?
  verifiedAt        DateTime?
  expiresAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  order             Order?          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  proposal          Proposal?       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  digitalServiceOrder DigitalServiceOrder? @relation(fields: [digitalServiceOrderId], references: [id], onDelete: Cascade)
  webhookEvents     WebhookEvent[]

  @@index([orderId, status])
  @@index([proposalId, status])
  @@index([digitalServiceOrderId, status])
  @@index([status, createdAt])
  @@unique([provider, providerReference])
}

model WebhookEvent {
  id              String    @id @default(cuid())
  provider        String
  dedupeKey       String    @unique
  eventType       String
  txRef           String?
  signatureValid  Boolean
  payload         Json
  processedAt     DateTime?
  processingError String?   @db.Text
  paymentId       String?
  receivedAt      DateTime  @default(now())
  payment         Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([provider, txRef])
  @@index([processedAt, receivedAt])
}

model LedgerEntry {
  id          String          @id @default(cuid())
  orderId     String?
  proposalId  String?
  digitalServiceOrderId String?
  type        LedgerEntryType
  amount      Decimal         @db.Decimal(14, 2)
  currency    String
  reference   String
  description String?
  createdAt   DateTime        @default(now())
  order       Order?          @relation(fields: [orderId], references: [id])
  proposal    Proposal?       @relation(fields: [proposalId], references: [id])
  digitalServiceOrder DigitalServiceOrder? @relation(fields: [digitalServiceOrderId], references: [id])

  @@unique([type, reference])
  @@index([orderId, createdAt])
  @@index([proposalId, createdAt])
  @@index([digitalServiceOrderId, createdAt])
}

model CreatorPaymentAccount {
  id                    String   @id @default(cuid())
  creatorId             String   @unique
  provider              String   @default("PAYCHANGU")
  connectStatus         String   @default("NOT_CONNECTED")
  providerAccountId     String?
  encryptedTokenRef     String?
  connectedAt           DateTime?
  lastVerifiedAt        DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  creator               CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
}

model Payout {
  id                String       @id @default(cuid())
  creatorId         String
  provider          String       @default("PAYCHANGU")
  status            PayoutStatus @default(QUEUED)
  amount            Decimal      @db.Decimal(14, 2)
  currency          String
  providerReference String?      @unique
  idempotencyKey    String       @unique
  failureReason     String?      @db.Text
  requestedAt       DateTime     @default(now())
  processedAt       DateTime?
  creator           CreatorProfile @relation(fields: [creatorId], references: [id])
  @@index([creatorId, status, requestedAt])
}

model Conversation {
  id        String    @id @default(cuid())
  subject   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  participants ConversationParticipant[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([conversationId, userId])
  @@index([userId, joinedAt])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  senderId       String
  type           MessageType @default(TEXT)
  body           String?     @db.Text
  attachmentKey  String?
  createdAt      DateTime    @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User        @relation("MessageSender", fields: [senderId], references: [id])
  @@index([conversationId, createdAt])
}

model Review {
  id          String   @id @default(cuid())
  authorId    String
  targetId    String
  creatorId   String
  orderId     String?
  rating      Int
  comment     String?  @db.Text
  createdAt   DateTime @default(now())
  author      User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  target      User     @relation("ReviewTarget", fields: [targetId], references: [id])
  creator     CreatorProfile @relation("CreatorReviews", fields: [creatorId], references: [id])
  @@unique([authorId, orderId])
  @@index([creatorId, createdAt])
}

/// External digital products and services that NJIRA is authorised and operationally able to fulfil.
model DigitalToolSupplier {
  id                  String         @id @default(cuid())
  name                String
  slug                String         @unique
  status              SupplierStatus @default(PENDING_REVIEW)
  websiteUrl          String?
  supportEmail        String?
  agreementReference  String?
  credentialVaultRef  String?
  settlementCurrency  String?
  notes               String?        @db.Text
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  tools               DigitalTool[]
  orders              DigitalServiceOrder[]

  @@index([status, name])
}

/// A catalogue entry; publication requires an approved supplier or fulfilment route.
model DigitalTool {
  id                    String            @id @default(cuid())
  supplierId            String?
  slug                  String            @unique
  name                  String
  vendorName            String
  category              String
  shortDescription      String
  description           String            @db.Text
  status                DigitalToolStatus @default(DRAFT)
  officialProductUrl    String?
  officialTermsUrl      String?
  supportUrl            String?
  supportedCountries    String[]          @default(["MW"])
  regionNotes           String?           @db.Text
  requiresCustomerEmail Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  supplier              DigitalToolSupplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  plans                 DigitalToolPlan[]

  @@index([status, category])
  @@index([supplierId, status])
}

/// A specific SKU/term. Price and currency are authoritative server-side values.
model DigitalToolPlan {
  id                    String             @id @default(cuid())
  toolId                String
  code                  String
  name                  String
  description           String?
  billingInterval       ToolBillingInterval
  termDays              Int?
  currency              String
  price                 Decimal            @db.Decimal(14, 2)
  supplierCost          Decimal?           @db.Decimal(14, 2)
  supplierCostCurrency  String?
  fulfillmentMethod     FulfillmentMethod
  externalProductRef    String?
  isActive              Boolean            @default(false)
  requiresRenewalNotice Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  tool                  DigitalTool        @relation(fields: [toolId], references: [id], onDelete: Cascade)
  orders                DigitalServiceOrder[]

  @@unique([toolId, code])
  @@index([toolId, isActive])
}

/// Customer purchase snapshot, separate from creator-service Orders.
model DigitalServiceOrder {
  id                    String                    @id @default(cuid())
  orderNumber           String                    @unique
  buyerId               String
  toolPlanId            String
  supplierId            String?
  status                DigitalServiceOrderStatus @default(PENDING_PAYMENT)
  currency              String
  unitPrice             Decimal                   @db.Decimal(14, 2)
  quantity              Int                       @default(1)
  total                 Decimal                   @db.Decimal(14, 2)
  supplierCost          Decimal?                  @db.Decimal(14, 2)
  supplierCostCurrency  String?
  customerEmail         String?
  customerAccountRef    String?
  idempotencyKey        String                    @unique
  supplierOrderRef      String?
  /// Immutable legal-role snapshot: identify who actually sells/supplies this SKU.
  sellerOfRecordName    String?
  sellerOfRecordCountryCode String?
  sellerRole            String?
  termsVersion          String?
  privacyNoticeVersion  String?
  /// Record only where the user expressly requests/consents to early digital delivery.
  digitalContentConsentAt DateTime?
  digitalContentConsentVersion String?
  paidAt                DateTime?
  fulfilledAt           DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  buyer                 User                      @relation(fields: [buyerId], references: [id])
  plan                  DigitalToolPlan           @relation(fields: [toolPlanId], references: [id])
  supplier              DigitalToolSupplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  payments              Payment[]
  ledgerEntries         LedgerEntry[]
  fulfillments          DigitalServiceFulfillment[]

  @@index([buyerId, createdAt])
  @@index([status, createdAt])
  @@index([supplierId, status])
  @@unique([supplierId, supplierOrderRef])
}

/// Delivery audit trail. Never store passwords, card details or reusable account credentials.
model DigitalServiceFulfillment {
  id                    String              @id @default(cuid())
  orderId               String
  status                FulfillmentStatus   @default(QUEUED)
  method                FulfillmentMethod
  supplierReference     String?
  secureDeliveryRef     String?
  customerInstructions  String?             @db.Text
  failureCode           String?
  failureDetails        String?             @db.Text
  deliveredAt           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  order                 DigitalServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([status, createdAt])
}



/// Immutable, versioned legal notice or agreement published by NJIRA.
model LegalDocumentVersion {
  id             String             @id @default(cuid())
  type           LegalDocumentType
  version        String
  locale         String             @default("en")
  status         LegalDocumentStatus @default(DRAFT)
  title          String
  documentUrl    String
  contentSha256  String
  effectiveAt    DateTime?
  publishedAt    DateTime?
  retiredAt      DateTime?
  createdAt      DateTime           @default(now())
  acceptances    LegalAcceptance[]

  @@unique([type, version, locale])
  @@index([type, status, effectiveAt])
}

/// Append-only record that a user accepted a specific published document version.
/// Store only a minimised IP hash if legally justified; never store raw IP here.
model LegalAcceptance {
  id                String   @id @default(cuid())
  userId            String?
  documentVersionId String
  acceptedAt        DateTime @default(now())
  context           String
  transactionRef    String?
  ipAddressHash     String?
  userAgentSummary  String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  documentVersion  LegalDocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)

  @@index([userId, acceptedAt])
  @@index([documentVersionId, acceptedAt])
  @@index([transactionRef])
}

/// Data-subject request workflow. Keep identity evidence outside this table in an
/// encrypted case store; subjectReferenceHash is a keyed, non-reversible reference.
model DataSubjectRequest {
  id                    String                    @id @default(cuid())
  userId                String?
  subjectReferenceHash  String
  type                  DataSubjectRequestType
  status                DataSubjectRequestStatus  @default(RECEIVED)
  receivedAt            DateTime                  @default(now())
  targetResponseAt      DateTime?
  identityVerifiedAt    DateTime?
  completedAt            DateTime?
  outcomeCode           String?
  secureCaseReference   String?
  legalHoldReasonCode   String?
  assignedTo            String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  user                  User?                     @relation("PrivacyRequestSubject", fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, receivedAt])
  @@index([subjectReferenceHash, receivedAt])
}

/// Security/privacy incident register. Do not put credentials or unnecessary personal
/// data in summaries; keep evidence in a restricted incident vault.
model ComplianceIncident {
  id                       String                     @id @default(cuid())
  incidentReference        String                     @unique
  severity                 ComplianceIncidentSeverity
  status                   ComplianceIncidentStatus   @default(OPEN)
  detectedAt               DateTime
  awarenessAt              DateTime?
  containedAt              DateTime?
  authorityNotifiedAt      DateTime?
  affectedSubjectsNotifiedAt DateTime?
  closedAt                 DateTime?
  summary                  String                     @db.Text
  reportabilityDecision    String?
  secureEvidenceReference  String?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  @@index([status, severity, detectedAt])
}

/// Feature/country release gate. A missing or non-approved record must fail closed.
model JurisdictionFeatureApproval {
  id                 String                       @id @default(cuid())
  countryCode        String
  featureKey         String
  status             JurisdictionApprovalStatus   @default(PENDING)
  legalReviewRef     String?
  approvedBy         String?
  approvedAt         DateTime?
  reviewDueAt        DateTime?
  notes              String?                      @db.Text
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  @@unique([countryCode, featureKey])
  @@index([countryCode, status])
}


/// Append-only, granular consent history. Contract performance must never depend
/// on optional marketing, analytics or personalization consent.
model ConsentEvent {
  id                 String         @id @default(cuid())
  userId             String?
  purpose            ConsentPurpose
  action             ConsentAction
  noticeVersion      String
  occurredAt         DateTime       @default(now())
  collectionSource   String
  evidenceReference  String?
  user               User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, purpose, occurredAt])
  @@index([purpose, occurredAt])
}
